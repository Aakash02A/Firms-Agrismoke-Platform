# ==============================================================================
# AgriSmoke AI - Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT commit real keys or secrets to version control (.env is git-ignored).
# On Render, set these in the dashboard / render.yaml instead of a .env file.
# ==============================================================================

# ---- Runtime environment -----------------------------------------------------
# production | staging | development
# In production: read-only mode + API docs off + HSTS are enabled by default.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Public HTTPS base URL of the deployed app (used for CORS/HSTS hints), e.g.
# https://agrismoke-ai.onrender.com
PUBLIC_URL=

# ---- CORS --------------------------------------------------------------------
# Comma-separated explicit origins allowed to call the API with credentials.
# Leave empty for same-origin hosting (frontend served by this backend).
# Do NOT use "*" together with credentials.
CORS_ORIGINS=

# ---- Security & exposure -----------------------------------------------------
# Expose interactive Swagger (/docs) and OpenAPI. Keep false in production.
DOCS_ENABLED=true
# Block all state-changing endpoints (POST/PUT/PATCH/DELETE) except the stateless
# /api/predict compute. Defaults to true when ENVIRONMENT=production.
READ_ONLY=
# Simple in-process per-client rate limiting for expensive ML/report endpoints.
RATE_LIMIT_ENABLED=
RATE_LIMIT_PER_MINUTE=60
# Trust X-Forwarded-* headers from a reverse proxy (Render / nginx).
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# ---- Database ----------------------------------------------------------------
# SQLite file location. Override for containers/PaaS to a mounted volume path.
# Leave blank to use the repo default (database/agri_smoke.db).
DB_PATH=
# Future managed-DB upgrade path (Supabase/Postgres). Not yet wired into queries.
DATABASE_URL=

# ---- NASA FIRMS API ----------------------------------------------------------
# Obtain an MAP Key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# This is a SECRET - never commit the real value.
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_DEFAULT_SENSOR=VIIRS_NOAA20_NRT
NASA_FIRMS_DAY_RANGE=3
NASA_FIRMS_REQUEST_TIMEOUT=30
NASA_FIRMS_CACHE_TTL=900

# ---- Redis (optional distributed cache) --------------------------------------
# If unset, the app transparently uses an in-memory TTL cache.
# REDIS_URL=redis://127.0.0.1:6379/0

# ---- Background scheduler ----------------------------------------------------
# Total kill-switches for the two background threads. Default true. A deploy
# MUST run a single app instance/worker so jobs fire exactly once; if you scale
# out, set these false everywhere except one designated worker service.
SCHEDULER_ENABLED=true
MAINTENANCE_ENABLED=true
# NASA FIRMS ingestion interval (seconds). Default 3h.
FIRMS_INTERVAL_SECONDS=10800
# Weather cache refresh interval (seconds). Default 15m.
WEATHER_INTERVAL_SECONDS=900

# ---- SQLite backup automation (maintenance scheduler) ------------------------
# Snapshot interval (seconds). Default 6h. A snapshot also runs once at boot.
BACKUP_INTERVAL_SECONDS=21600
# How many local snapshots to keep on disk (older ones pruned after each backup).
BACKUP_RETENTION_KEEP=10
# Directory for local snapshots. Default: <db dir>/backups.
BACKUP_DIR=
# Refuse to consider the volume healthy below this much free space (MB); logged
# as a warning before a backup so a full disk is caught early.
SQLITE_MIN_FREE_MB=512

# ---- Off-site backup (DISASTER RECOVERY) ------------------------------------
# A snapshot on the SAME persistent disk is NOT disaster recovery: if the volume
# is lost the backup is lost with it. Pick ONE off-site destination:
#   none      - local snapshots only (default; NOT off-site)
#   directory - copy each snapshot to OFFSITE_BACKUP_DIR (a DIFFERENT disk/mount)
#   s3        - upload to an S3-compatible bucket (AWS S3 / Cloudflare R2 /
#               Backblaze B2 / MinIO). Requires `pip install boto3`.
OFFSITE_BACKEND=none
# Used by OFFSITE_BACKEND=directory. MUST be a path not on the DB volume.
OFFSITE_BACKUP_DIR=
# Used by OFFSITE_BACKEND=s3. The secret access key is a SECRET - set it in the
# Render dashboard, never here.
OFFSITE_S3_BUCKET=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_PREFIX=backups
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=

# ---- Data retention (aged-row pruning) --------------------------------------
# Retention pass interval (seconds). Default 24h.
RETENTION_INTERVAL_SECONDS=86400
# Actually delete aged rows (false = dry run that only reports counts).
RETENTION_APPLY=true
# Always take a fresh backup immediately before any destructive prune.
BACKUP_BEFORE_RETAIN=true
# Per-table retention windows (days). Only whitelisted history tables are pruned.
FIRE_OBS_RETENTION_DAYS=180
FIRE_EVENTS_RETENTION_DAYS=180
SIM_HISTORY_RETENTION_DAYS=90
SYNC_JOBS_RETENTION_DAYS=90


# ---- Local docker-compose Postgres (development only) ------------------------
# Supply strong values; used by deploy/docker-compose.yml. Never reuse in prod.
# POSTGRES_USER=agrismoke
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=agrismoke_db
